{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/data/**",
              "components/foundations/**",
              "components/media/**",
              "ui_kits/slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|meta|key|ref|className|style|children)$/]",
        "message": "<AgendaItem> doesn't accept that prop. Declared props: index, label, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|color|key|ref|className|style|children)$/]",
        "message": "<BarSeries> doesn't accept that prop. Declared props: percent, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|children|style|key|ref|className|style|children)$/]",
        "message": "<BigNumber> doesn't accept that prop. Declared props: value, unit, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|height|base|style|key|ref|className|style|children)$/]",
        "message": "<BrandLogo> doesn't accept that prop. Declared props: variant, tone, height, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|vertical|mark)$/]",
        "message": "<BrandLogo> variant must be one of 'horizontal' | 'vertical' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|black|color)$/]",
        "message": "<BrandLogo> tone must be one of 'white' | 'black' | 'color'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrowserFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|src|placeholder|children|style|key|ref|className|style|children)$/]",
        "message": "<BrowserFrame> doesn't accept that prop. Declared props: url, src, placeholder, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: eyebrow, children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mist|sand|deep|paper)$/]",
        "message": "<Callout> tone must be one of 'mist' | 'sand' | 'deep' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|width|align|muted|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, width, align, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<DonutSegment> doesn't accept that prop. Declared props: label, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|onDark|onStrong|muted|warn)$/]",
        "message": "<Eyebrow> tone must be one of 'default' | 'onDark' | 'onStrong' | 'muted' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|color|dashed|endDot|key|ref|className|style|children)$/]",
        "message": "<LineSeries> doesn't accept that prop. Declared props: points, color, dashed, endDot."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatrixItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|color|key|ref|className|style|children)$/]",
        "message": "<MatrixItem> doesn't accept that prop. Declared props: key, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|placeholder|rounded|style|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, alt, caption, placeholder, rounded, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|percent|tone|style|key|ref|className|style|children)$/]",
        "message": "<MeterRow> doesn't accept that prop. Declared props: label, value, percent, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:deep|sage)$/]",
        "message": "<MeterRow> tone must be one of 'deep' | 'sage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrincipleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|children|style|key|ref|className|style|children)$/]",
        "message": "<PrincipleCard> doesn't accept that prop. Declared props: index, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|name|role|avatar|style|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, name, role, avatar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|size|gap|style|key|ref|className|style|children)$/]",
        "message": "<RingList> doesn't accept that prop. Declared props: items, tone, size, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|strong)$/]",
        "message": "<RingList> tone must be one of 'light' | 'dark' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|height|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: tone, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Rule> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|aside|tone|size|divider|style|key|ref|className|style|children)$/]",
        "message": "<SlideHeader> doesn't accept that prop. Declared props: eyebrow, title, aside, tone, size, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SlideHeader> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:section|heading|subsection)$/]",
        "message": "<SlideHeader> size must be one of 'section' | 'heading' | 'subsection'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, unit, label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|deep)$/]",
        "message": "<StatCard> tone must be one of 'paper' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|size|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, label, size, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|warn|risk)$/]",
        "message": "<StatusDot> status must be one of 'ok' | 'warn' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mist|sand|deep|outline)$/]",
        "message": "<Tag> tone must be one of 'mist' | 'sand' | 'deep' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamMember'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|role|children|size|style|key|ref|className|style|children)$/]",
        "message": "<TeamMember> doesn't accept that prop. Declared props: photo, name, role, children, size, style."
