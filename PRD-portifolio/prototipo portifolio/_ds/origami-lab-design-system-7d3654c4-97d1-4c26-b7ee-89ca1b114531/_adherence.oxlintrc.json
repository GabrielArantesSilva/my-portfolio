      {
        "selector": "JSXOpeningElement[name.name='TimelinePhase'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|period|title|description|status|current|key|ref|className|style|children)$/]",
        "message": "<TimelinePhase> doesn't accept that prop. Declared props: label, period, title, description, status, current."
      }
    ]
  },
