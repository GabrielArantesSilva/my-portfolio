{
  "name": "gabriel-arantes-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "sync:vault": "node scripts/sync-vault.mjs",
    "sync:activity": "node scripts/sync-activity.mjs",
    "sync": "npm run sync:vault && npm run sync:activity",
    "check:content": "node scripts/check-content.mjs",
    "build": "tsc -b && vite build",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run check:content && npm run typecheck && npm run lint && npm test && vercel --prod --yes"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.1.3",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
